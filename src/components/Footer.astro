---
import NavLink from "@components/NavLink.astro";

const links = [
  { href: "https://monkeytype.com/profile/jproffer", label: "Monkeytype" },
  {
    href: "https://dribbble.com/jacobproffer/",
    label: "Dribbble",
  },
  {
    href: "https://www.wanikani.com/users/chongo",
    label: "WaniKani",
  },
];
---

<footer
  class="p-3 bg-linear-to-t from-surface-deep to-surface-gradient border border-page border-l-border-highlight border-t-border-highlight"
>
  <nav aria-label="secondary">
    <ul class="flex gap-4 max-md:flex-col max-md:text-center">
      {
        links
          .sort((a, b) => a.label.localeCompare(b.label))
          .map((link) => (
            <li>
              <NavLink href={link.href}>{link.label}</NavLink>
            </li>
          ))
      }
    </ul>
  </nav>
</footer>
