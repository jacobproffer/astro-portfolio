---
interface Props {
  items: Array<{ key: string; value: string }>;
  class?: string;
}

const { items, class: className } = Astro.props;
---

<dl class:list={["label grid gap-2", className]} data-readout>
  {
    items.map((item) => (
      <div class="flex items-end gap-2">
        <dt class="text-mute">{item.key}</dt>
        <span class="leader" aria-hidden="true" />
        <dd class="text-right">{item.value}</dd>
      </div>
    ))
  }
</dl>

<script>
  import { bootReadouts } from "../utils/textEffects";

  bootReadouts();
</script>
