---
import Section from "./Section.astro";

interface Props {
  headline: string;
}

const { headline } = Astro.props;
---

<Section>
  <div class="grid gap-4">
    {
      headline && (
        <h1 class="text-4xl font-semibold tracking-tight text-gray sm:text-5xl">
          Hi, I'm {headline.replace("Jacob Proffer", "Jacob")}
        </h1>
      )
    }
    <div class="muted-copy max-w-4xl text-gray"><slot /></div>
  </div>
</Section>
