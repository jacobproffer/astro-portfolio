---
import { Image } from "astro:assets";
import thumbnail from "@images/proffer_jacob.jpg";
---

<figure class="group relative aspect-square overflow-hidden bg-acid">
  <Image
    class="size-full object-cover grayscale contrast-125 mix-blend-multiply transition duration-700 group-hover:scale-105"
    src={thumbnail}
    alt="Portrait of Jacob Proffer"
    widths={[240, 360, thumbnail.width]}
    sizes="(max-width: 767px) 240px, 360px"
    quality="mid"
    loading="eager"
  />
  <figcaption
    class="label absolute bottom-2 left-2 bg-ink px-1.5 py-0.5 text-acid"
  >
    Fig. 01
  </figcaption>
</figure>
