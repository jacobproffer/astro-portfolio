---
interface Props {
  items: string[];
}

const { items } = Astro.props;

// Each half of the track must be wider than the widest viewport, or a gap
// shows before the -50% loop resets. Repeat the items to pad it out.
const REPEAT = 3;
const run = Array.from({ length: REPEAT }, () => items).flat();
---

<div
  class="marquee group/marquee relative overflow-hidden border-b border-line bg-acid text-ink"
>
  <p class="sr-only">{items.join(", ")}</p>
  <div
    class="flex w-max py-3 motion-safe:animate-marquee group-hover/marquee:[animation-play-state:paused] group-data-paused/marquee:[animation-play-state:paused]"
    aria-hidden="true"
  >
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0">
          {run.map((item) => (
            <li class="font-wide flex items-center gap-6 pr-6 text-lg font-extrabold whitespace-nowrap uppercase">
              {item}
              <span class="text-base">✱</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <!-- WCAG 2.2.2: a keyboard-operable way to stop the motion. Shown once the
       script runs; hidden when reduced motion already stops the animation. -->
  <button
    type="button"
    class="marquee-toggle label absolute inset-y-0 right-0 flex items-center gap-2 bg-ink px-4 text-acid transition-colors hover:bg-panel focus-visible:-outline-offset-4 motion-reduce:hidden"
    hidden
  >
    <span class="marquee-icon w-3 text-center" aria-hidden="true">❚❚</span>
    <span class="marquee-label">Pause</span>
  </button>
</div>

<script>
  const STORAGE_KEY = "marquee-paused";

  document.querySelectorAll<HTMLElement>(".marquee").forEach((marquee) => {
    const toggle = marquee.querySelector<HTMLButtonElement>(".marquee-toggle");
    const icon = marquee.querySelector(".marquee-icon");
    const label = marquee.querySelector(".marquee-label");
    if (!toggle || !icon || !label) return;

    const setPaused = (paused: boolean) => {
      marquee.toggleAttribute("data-paused", paused);
      icon.textContent = paused ? "▶" : "❚❚";
      label.textContent = paused ? "Play" : "Pause";
      try {
        localStorage.setItem(STORAGE_KEY, String(paused));
      } catch {
        // Storage can be unavailable; the toggle still works for this visit.
      }
    };

    let saved = false;
    try {
      saved = localStorage.getItem(STORAGE_KEY) === "true";
    } catch {}

    setPaused(saved);
    toggle.hidden = false;
    toggle.addEventListener("click", () =>
      setPaused(!marquee.hasAttribute("data-paused")),
    );
  });
</script>
