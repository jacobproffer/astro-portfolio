---
import NavLink from "@components/NavLink.astro";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<NavLink
  class="grid size-14 place-items-center rounded-full border border-icon-button-border bg-icon-button-background p-0 text-icon-button-foreground transition-colors hover:border-icon-button-hover-border hover:bg-icon-button-hover-background hover:text-white focus-visible:border-icon-button-hover-border focus-visible:bg-icon-button-hover-background focus-visible:text-white"
  href={href}
  aria-label={label}
  title={label}
>
  <slot />
</NavLink>
