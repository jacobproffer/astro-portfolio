---
interface Props {
  href: string;
  class?: string;
  [key: string]: any;
}

const url = new URL(Astro.props.href, Astro.url);
const isExternal = url.host !== Astro.url.host;

const { class: className, ...otherProps } = Astro.props;
---

<a
  class:list={[
    "label group inline-flex items-center gap-1 transition-colors hover:text-acid",
    className,
  ]}
  target={isExternal ? "_blank" : null}
  rel={isExternal ? "noopener noreferrer" : null}
  {...otherProps}
>
  <slot />
  {
    isExternal && (
      <>
        <span
          class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          ↗
        </span>
        <span class="sr-only">(opens in a new tab)</span>
      </>
    )
  }
</a>
