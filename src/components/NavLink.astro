---
interface Props {
  class?: string;
  [key: string]: any;
}

const url = new URL(Astro.props.href, Astro.url);
const isExternal = url.host !== Astro.url.host;
const isCurrent = url.href === Astro.url.href;

// Extract class and other props separately
const { class: className, ...otherProps } = Astro.props;
---

<a
  class:list={[
    "block py-2 px-4 text-foreground bg-linear-to-t from-surface-deep to-surface-gradient border border-page border-t-border-highlight border-l-border-highlight motion-safe:focus:animate-pulse focus:outline-4 focus:outline-accent focus:-outline-offset-4 hover:text-accent hover:border-t-page hover:border-l-page hover:border-r-border-highlight hover:border-b-border-highlight transition-colors",
    className,
  ]}
  aria-current={isCurrent ? "page" : null}
  target={isExternal ? "_blank" : "_self"}
  {...otherProps}
>
  <slot />
</a>
