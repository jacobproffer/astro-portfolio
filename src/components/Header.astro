---
import Container from "@components/Container.astro";
import Logo from "@components/Logo.astro";
import Navigation from "@components/Navigation.astro";
import { location } from "@/data/site";
---

<header
  class="sticky top-0 z-40 border-b border-line bg-ink/85 backdrop-blur-md"
>
  <Container class="grid h-14 grid-cols-[1fr_auto] items-center gap-6 xl:grid-cols-12">
    <div class="xl:col-span-3">
      <Logo />
    </div>
    <p class="label whitespace-nowrap text-mute max-xl:hidden xl:col-span-2">
      [ Front-End Developer ]
    </p>
    <p class="label whitespace-nowrap text-mute max-xl:hidden xl:col-span-2">
      {location.coordinates}
    </p>
    <div class="xl:col-span-5 xl:justify-self-end">
      <Navigation />
    </div>
  </Container>
</header>
