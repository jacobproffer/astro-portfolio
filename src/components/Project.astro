---
import { Image } from "astro:assets";

interface Props {
  index: number;
  thumbnail: ImageMetadata;
  headline: string;
  description?: string;
  url: string;
  tags?: Array<string>;
}

const { index, thumbnail, headline, description, url, tags } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<a
  class="group relative grid gap-4 border-t border-line py-6 transition-colors hover:bg-panel focus-visible:bg-panel md:grid-cols-12 md:gap-6 md:py-8"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="label pt-1 text-mute group-hover:text-acid md:col-span-1">
    {number} /
  </span>

  <div class="grid content-start gap-4 md:col-span-7">
    <h3
      class="font-wide text-[clamp(1.75rem,4.4vw,4rem)] leading-[0.9] font-extrabold tracking-[-0.03em] text-balance uppercase transition-[color,font-stretch] duration-500 md:text-outline md:group-hover:text-acid md:group-hover:[-webkit-text-stroke-color:var(--color-acid)] md:group-focus-visible:text-acid"
    >
      {headline}
      <span class="sr-only">(opens in a new tab)</span>
    </h3>
    {
      description && (
        <p class="max-w-xl leading-relaxed text-mute group-hover:text-bone">
          {description}
        </p>
      )
    }
    {
      tags && (
        <ul class="label flex flex-wrap gap-x-4 gap-y-1">
          {tags.map((tag: string) => (
            <li>[{tag}]</li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="relative md:col-span-4">
    <div class="aspect-project overflow-hidden border border-line">
      <Image
        class="size-full object-cover transition duration-700 md:grayscale md:group-hover:scale-105 md:group-hover:grayscale-0"
        src={thumbnail}
        alt=""
        widths={[400, 600, 800]}
        sizes="(max-width: 767px) 100vw, 33vw"
        loading="lazy"
        quality="mid"
      />
    </div>
    <span
      class="absolute -top-3 -right-1 grid size-9 place-items-center bg-acid text-ink opacity-0 transition duration-300 group-hover:opacity-100 max-md:hidden"
      aria-hidden="true"
    >
      ↗
    </span>
  </div>
</a>
