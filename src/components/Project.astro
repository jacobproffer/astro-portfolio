---
import { Image } from "astro:assets";
import TertiaryHeadline from "./TertiaryHeadline.astro";

interface Props {
  thumbnail: ImageMetadata;
  thumbnailAlt: string;
  headline: string;
  description?: string;
  url: string;
  tags?: Array<string>;
}

const { thumbnail, thumbnailAlt, headline, description, url, tags } =
  Astro.props;
---

<a
  class="relative grid gap-4 text-gray outline-none transition-opacity hover:opacity-75 focus-visible:outline-2 focus-visible:outline-light-blue"
  href={url}
  target="_blank"
>
  {
    thumbnail && (
      <div class="aspect-[1.35] overflow-hidden rounded-3xl border border-[#242424] bg-dark-blue">
        <Image
          class="h-full w-full object-cover"
          src={thumbnail}
          alt={thumbnailAlt}
          widths={[271, 663, 285]}
          sizes="(max-width: 376px) 297px, (min-width: 376px) and (max-width: 767px) 663px, (min-width: 768px) 285px"
          loading="lazy"
          quality="mid"
        />
      </div>
    )
  }
  <div class="grid gap-1 px-1">
    {headline && <TertiaryHeadline text={headline} />}
    {description && <p class="muted-copy line-clamp-2">{description}</p>}
    {
      tags && (
        <ul class="hidden">
          {tags.map((tag: string) => (
            <li class="border border-[#252525] bg-dark-blue px-1.5 text-[0.6rem] text-light-blue">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
