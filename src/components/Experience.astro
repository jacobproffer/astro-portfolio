---
import Container from "@components/Container.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { formatShortDate } from "@utils/date";
import { getCollection } from "astro:content";

// Load experience from content collection
const experienceItems = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);

const education = {
  school: "Northern Michigan University",
  degree: "BFA, Electronic Imaging",
  startDate: "2010-08",
  endDate: "2014-05",
};

const dateRange = (start: string, end?: string) =>
  `${formatShortDate(start)} → ${end ? formatShortDate(end) : "Present"}`;
---

<section aria-labelledby="experience" class="border-b border-line">
  <Container class="pb-16 md:pb-24">
    <SectionHeader
      id="experience"
      index="02"
      title="Experience"
      meta="Employment record"
    />

    <div
      class="relative grid bg-acid text-ink md:grid-cols-[4.5rem_1fr]"
      data-animate
      id="experience-ticket"
    >
      <!-- Ticket stub -->
      <div
        class="flex items-center justify-between gap-4 border-b border-dashed border-ink/50 px-4 py-3 md:flex-col md:border-r md:border-b-0 md:px-0 md:py-6"
      >
        <span class="label md:[writing-mode:vertical-rl] md:rotate-180">
          Record / Front-End Development
        </span>
        <span class="label md:[writing-mode:vertical-rl] md:rotate-180">
          2015 → Present
        </span>
      </div>

      <div class="px-4 md:px-8">
        <ol>
          {
            experienceItems.map((item, index) => (
              <li
                class:list={[
                  "grid gap-4 py-6 md:grid-cols-12 md:gap-6 md:py-8",
                  index > 0 && "border-t border-ink/30",
                ]}
              >
                <h3 class="font-wide text-2xl leading-none font-extrabold tracking-tight uppercase md:col-span-5 md:text-4xl">
                  {item.data.company}
                </h3>
                <div class="grid gap-4 md:col-span-7">
                  <ol class="grid gap-2">
                    {item.data.positions.map((position) => (
                      <li class="flex items-end gap-3">
                        <span class="font-semibold">{position.position}</span>
                        <span class="leader" aria-hidden="true" />
                        <span class="label whitespace-nowrap">
                          {dateRange(position.startDate, position.endDate)}
                        </span>
                      </li>
                    ))}
                  </ol>
                  {item.data.highlights?.length && (
                    <ul class="grid gap-1 text-sm leading-relaxed">
                      {item.data.highlights.map((highlight) => (
                        <li class="flex gap-2">
                          <span aria-hidden="true">✱</span>
                          {highlight}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Perforated divider with ticket notches -->
      <div
        class="relative border-t border-dashed border-ink/50 md:col-span-2"
        aria-hidden="true"
      >
        <span class="absolute top-0 -left-3 size-6 -translate-y-1/2 rounded-full bg-ink"></span>
        <span class="absolute top-0 -right-3 size-6 -translate-y-1/2 rounded-full bg-ink"></span>
      </div>

      <div
        class="grid gap-4 px-4 py-6 md:col-span-2 md:grid-cols-[4.5rem_1fr] md:gap-0 md:px-0 md:py-8"
      >
        <h3 class="label md:text-center">Edu.</h3>
        <div class="grid gap-2 md:grid-cols-12 md:gap-6 md:px-8">
          <p class="font-wide text-xl leading-none font-extrabold uppercase md:col-span-5 md:text-2xl">
            {education.school}
          </p>
          <p class="flex items-end gap-3 md:col-span-7">
            <span class="font-semibold">{education.degree}</span>
            <span class="leader" aria-hidden="true"></span>
            <span class="label whitespace-nowrap">
              {dateRange(education.startDate, education.endDate)}
            </span>
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { animateOnScroll } from "../utils/animations";

  const ticket = document.getElementById("experience-ticket");
  if (ticket) {
    animateOnScroll(ticket);
  }
</script>
