---
import Section from "@components/Section.astro";
import SecondaryHeadline from "@components/SecondaryHeadline.astro";
import Project from "@components/Project.astro";
import { getCollection } from "astro:content";

interface Props {
  headline: string;
}

const { headline } = Astro.props;

// Load projects from content collection
const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Section>
  <div id="work" class="grid gap-4">
    <div class="flex items-center justify-between">
      <SecondaryHeadline text={headline} />
      <a
        class="text-[0.65rem] text-gray underline-offset-4 hover:underline"
        href="#work-list">View all</a
      >
    </div>
    <ol id="work-list" class="grid grid-cols-2 gap-x-2 gap-y-6">
      {
        projects.map((entry) => (
          <li class="project-item" data-animate>
            <Project
              url={entry.data.url}
              headline={entry.data.title}
              description={entry.data.description ?? ""}
              tags={entry.data.tags ?? []}
              thumbnail={entry.data.thumbnail}
              thumbnailAlt=""
            />
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  import { animateOnScroll } from "../utils/animations";

  // Animate each project as it scrolls into view
  document.querySelectorAll(".project-item").forEach((item) => {
    animateOnScroll(item);
  });
</script>
