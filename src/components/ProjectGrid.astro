---
import Container from "@components/Container.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Project from "@components/Project.astro";
import { getCollection } from "astro:content";

// Load projects from content collection
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section aria-labelledby="work" class="border-b border-line">
  <Container>
    <SectionHeader
      id="work"
      index="01"
      title="Selected Projects"
      meta={`[${String(projects.length).padStart(2, "0")}] entries`}
    />
    <ol class="pb-16 md:pb-24">
      {
        projects.map((entry, index: number) => (
          <li class="project-item" data-animate>
            <Project
              index={index}
              url={entry.data.url}
              headline={entry.data.title}
              description={entry.data.description ?? ""}
              tags={entry.data.tags ?? []}
              thumbnail={entry.data.thumbnail}
            />
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<script>
  import { animateOnScroll } from "../utils/animations";

  // Animate each project as it scrolls into view
  document.querySelectorAll(".project-item").forEach((item) => {
    animateOnScroll(item);
  });
</script>
