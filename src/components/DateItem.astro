---
import { formatDate } from "@utils/date";

interface Props {
  type: string;
  title: string;
  startDate?: string;
  endDate?: string;
}

const { title, startDate, endDate } = Astro.props;
---

<div
  class="flex flex-col items-start gap-1"
>
  <h4 class="text-xs text-gray text-balance leading-5">{title}</h4>
  <div class="flex flex-wrap items-center gap-1 text-[0.65rem] text-[#777]">
    {startDate && (
      <time datetime={startDate}>{formatDate(startDate)}</time>
      <div class="text-light-blue">-</div>
    )}
    {endDate ? (
      <time datetime={endDate}>{formatDate(endDate)}</time>
    ) : (
      <span>Present</span>
    )}
  </div>
</div>
