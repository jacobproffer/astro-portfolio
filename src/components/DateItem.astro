---
import { formatDate } from "@utils/date";

interface Props {
  type: string;
  title: string;
  startDate?: string;
  endDate?: string;
}

const { title, startDate, endDate } = Astro.props;
---

<div
  class="flex flex-col items-start gap-2"
>
  <h4 class="text-base font-medium leading-6 text-foreground text-balance">{title}</h4>
  <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-icon-muted">
    {startDate && (
      <time datetime={startDate}>{formatDate(startDate)}</time>
      <div class="text-accent">-</div>
    )}
    {endDate ? (
      <time datetime={endDate}>{formatDate(endDate)}</time>
    ) : (
      <span>Present</span>
    )}
  </div>
</div>
