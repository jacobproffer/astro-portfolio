---
import BaseLayout from "@layouts/BaseLayout.astro";
import Avatar from "@components/Avatar.astro";
import Hero from "@components/Hero.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import Experience from "@components/Experience.astro";
import Education from "@components/Education.astro";
import Languages from "@components/Languages.astro";
import { Image } from "astro:assets";
import aboutCoding from "@images/proffer_jacob.jpg";
import aboutBridge from "@images/airports.jpg";
import aboutDog from "@images/unhealthy_obsession.jpg";
const pageTitle = "Jacob Proffer – Front-End Developer";
const heroHeadline = "Jacob Proffer";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="grid gap-32">
    <div class="grid max-w-2xl gap-8">
      <div class="w-16">
        <Avatar />
      </div>
      <Hero headline={heroHeadline}>
        <p class="max-w-4xl text-foreground">
          I'm a front-end developer based in Marquette, Michigan with eleven
          years of agency experience. I specialize in crafting accessible and
          performant solutions for the web.
        </p>
      </Hero>
    </div>
    <ProjectGrid headline="Personal Projects" />
    <Languages />
    <section id="about" aria-labelledby="about-heading" class="grid gap-5">
      <h2 id="about-heading">About</h2>
      <div class="grid gap-8">
        <p>
          I started coding out of curiosity and grew into developing complete
          products that balance design and engineering.
        </p>
        <p>
          My stack includes TypeScript, React, Next.js, Node, and PostgreSQL,
          but I love exploring new technologies that make the web better.
        </p>
      </div>
      <div class="grid grid-cols-3 items-start gap-4 pt-8">
        <Image
          class="aspect-portrait w-full rotate-2 rounded-2xl object-cover"
          src={aboutCoding}
          alt=""
        />
        <Image
          class="aspect-portrait w-full -rotate-2 rounded-2xl object-cover"
          src={aboutBridge}
          alt=""
        />
        <Image
          class="aspect-portrait w-full rotate-2 rounded-2xl object-cover"
          src={aboutDog}
          alt=""
        />
      </div>
    </section>
    <div class="grid gap-10">
      <Experience />
      <div class="grid gap-10">
        <Education />
      </div>
    </div>
  </div>
</BaseLayout>
